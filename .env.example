# =============================================================================
# LMIS — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM Provider — pick ONE primary provider (or configure all for fallback chain)
# -----------------------------------------------------------------------------
LLM_PROVIDER=anthropic                          # anthropic | openai | google | local

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Google Gemini
GOOGLE_API_KEY=AIza...
GOOGLE_MODEL=gemini-1.5-pro

# Local LLM via Ollama (fallback / PHI-safe offline mode)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Primary models for each role
GENERATOR_MODEL=claude-3-5-sonnet-20241022      # Reasoning / Generation Agent
VERIFIER_MODEL=claude-3-5-sonnet-20241022       # Verification / Critic Agent
FAST_MODEL=claude-3-haiku-20240307              # Quick classification tasks

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://lmis:lmis_dev_password@localhost:5432/lmis_db
POSTGRES_USER=lmis
POSTGRES_PASSWORD=lmis_dev_password
POSTGRES_DB=lmis_db

# -----------------------------------------------------------------------------
# Redis (task queue + cache)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# -----------------------------------------------------------------------------
# MinIO (object storage — raw documents, OCR crops)
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=lmis_minio_access
MINIO_SECRET_KEY=lmis_minio_secret_key_change_in_prod
MINIO_BUCKET_DOCUMENTS=lmis-documents
MINIO_BUCKET_OCR=lmis-ocr-crops
MINIO_SECURE=false                              # set true in production (HTTPS)

# -----------------------------------------------------------------------------
# Qdrant (vector store)
# -----------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=                                 # leave empty for local dev
QDRANT_COLLECTION_KNOWLEDGE=lmis_knowledge
QDRANT_COLLECTION_PATIENT_PREFIX=lmis_patient_  # namespaced per patient

# -----------------------------------------------------------------------------
# Embedding models
# -----------------------------------------------------------------------------
EMBEDDING_MODEL_GENERAL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL_BIOMEDICAL=allenai/scibert_scivocab_uncased
EMBEDDING_DIMENSION=384

# -----------------------------------------------------------------------------
# Authentication & Security
# -----------------------------------------------------------------------------
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development                             # development | production
APP_NAME=LMIS
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO
BACKEND_PORT=8000
FRONTEND_PORT=3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# PHI Handling
# -----------------------------------------------------------------------------
PHI_REDACTION_ENABLED=true                      # always true in production
PHI_ENCRYPTION_KEY=                             # 32-byte Fernet key (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")

# -----------------------------------------------------------------------------
# Confidence Thresholds
# -----------------------------------------------------------------------------
OCR_CONFIDENCE_THRESHOLD=0.70                   # below this → flag for human review
NER_CONFIDENCE_THRESHOLD=0.75
ONTOLOGY_MATCH_THRESHOLD=0.80
TREND_MIN_DATA_POINTS=3
RETRIEVAL_SIMILARITY_THRESHOLD=0.72
CRITICAL_VALUE_AUTO_ESCALATE=true

# -----------------------------------------------------------------------------
# HuggingFace (for model downloads)
# -----------------------------------------------------------------------------
HUGGINGFACE_HUB_TOKEN=hf_...
HF_HOME=/app/.cache/huggingface

# -----------------------------------------------------------------------------
# Azure Document Intelligence (evaluation baseline only — not production)
# -----------------------------------------------------------------------------
AZURE_FORM_RECOGNIZER_ENDPOINT=
AZURE_FORM_RECOGNIZER_KEY=
